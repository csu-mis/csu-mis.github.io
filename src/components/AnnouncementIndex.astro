---
import AnnouncementCard from './AnnouncementCard.astro';
import Icon from './Icon.astro';
import { CATEGORIES, CATEGORY_SLUGS, type Announcement, type Category } from '../lib/announcements';
import { useTranslations } from '../i18n';
import { url } from '../lib/url';

interface Props {
  entries: Announcement[];
  /** undefined 代表「全部」 */
  activeCategory?: Category;
  /** 各分類的公告數量，用於顯示在篩選鈕上 */
  counts: Record<string, number>;
  total: number;
}

const { entries, activeCategory, counts, total } = Astro.props;
const t = useTranslations();
---

<div class="container section--tight chip-bar-page">
  <nav class="chip-bar" aria-label={t.announcements.filterLabel}>
    <p class="chip-bar__label" id="announcement-filter-label">
      <Icon name="filter" size={16} />
      {t.announcements.categoryFieldLabel}
    </p>

    <div class="chip-bar__scroller">
      <ul class="chip-bar__list" aria-labelledby="announcement-filter-label">
        <li>
          <a
            href={url("/announcements")}
            class:list={['chip-bar__item', { 'is-active': !activeCategory }]}
            aria-current={!activeCategory ? 'page' : undefined}
          >
            {t.announcements.all}
            <span class="chip-bar__count">{total}</span>
          </a>
        </li>
        {
          CATEGORIES.map((category) => (
            <li>
              <a
                href={url(`/announcements/category/${CATEGORY_SLUGS[category]}`)}
                class:list={['chip-bar__item', { 'is-active': activeCategory === category }]}
                aria-current={activeCategory === category ? 'page' : undefined}
              >
                {category}
                <span class="chip-bar__count">{counts[category] ?? 0}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <a class="chip-bar__action" href={url("/rss.xml")}>
      <Icon name="rss" size={15} />
      {t.announcements.rss}
    </a>
  </nav>

  <script>
    // 窄螢幕膠囊列會橫滑；進頁時把目前選取項捲進可視範圍
    const active = document.querySelector<HTMLElement>('.chip-bar .is-active');
    active?.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' });
  </script>

  {
    entries.length > 0 ? (
      <div class="grid grid--3 announcements-grid">
        {entries.map((entry) => (
          <AnnouncementCard entry={entry} />
        ))}
      </div>
    ) : (
      <p class="empty">{t.announcements.empty}</p>
    )
  }
</div>
