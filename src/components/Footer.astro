---
import { site, currentYear } from "../lib/site";
import { useTranslations } from "../i18n";
import { url } from "../lib/url";
import Icon from "./Icon.astro";

const t = useTranslations();

const links = [
    { href: url("/"), label: t.nav.home },
    { href: url("/announcements"), label: t.nav.announcements },
    { href: url("/calendar"), label: t.nav.calendar },
    { href: url("/officers"), label: t.nav.officers },
    { href: url("/about"), label: t.nav.about },
];

type SocialIcon = "instagram" | "facebook" | "threads" | "github";
---

<footer class="footer">
    <div class="container footer__grid">
        <div class="footer__brand">
            <img
                class="footer__logo"
                src={url("/logo.png")}
                alt=""
                width="52"
                height="52"
                loading="lazy"
                decoding="async"
            />
            <p class="footer__name">{site.name}</p>
            <p class="footer__meta">{site.englishName} · {site.termLabel}</p>
        </div>

        <nav class="footer__col" aria-label="頁尾導覽">
            <h2 class="footer__title">{t.footer.siteTitle}</h2>
            <ul class="footer__list">
                {
                    links.map((link) => (
                        <li>
                            <a href={link.href}>{link.label}</a>
                        </li>
                    ))
                }
                <li>
                    <a href={url("/rss.xml")}>{t.announcements.rss}</a>
                </li>
            </ul>
        </nav>

        <div class="footer__col">
            <h2 class="footer__title">{t.footer.contactTitle}</h2>
            <ul class="footer__list footer__list--icons">
                <li>
                    <Icon name="mail" size={16} />
                    <a href={`mailto:${site.contact.email}`}
                        >{site.contact.email}</a
                    >
                </li>
                <li>
                    <Icon name="map-pin" size={16} />
                    <span>{site.contact.office}</span>
                </li>
                <li>
                    <Icon name="clock" size={16} />
                    <span>{site.contact.officeHours}</span>
                </li>
            </ul>
        </div>

        <div class="footer__col">
            <h2 class="footer__title">{t.footer.followTitle}</h2>
            <ul class="footer__social">
                {
                    site.social.map((item) => (
                        <li>
                            <a
                                href={item.url}
                                class="footer__social-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon
                                    name={item.icon as SocialIcon}
                                    size={18}
                                />
                                <span>{item.handle}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div class="container footer__bottom">
        <p>© {currentYear} {site.name} {t.footer.rights}</p>
        <p>{t.footer.builtWith}</p>
    </div>
</footer>
