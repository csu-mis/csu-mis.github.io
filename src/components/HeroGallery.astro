---
import { getHeroPhotos, HERO_PHOTO_SIZES } from '../lib/heroPhotos';
import { useTranslations } from '../i18n';

const t = useTranslations();
const photos = await getHeroPhotos();

// 900px 以下不顯示輪播。只靠 display:none 無法保證瀏覽器不下載，
// 所以窄螢幕的 <source> 指向 1×1 透明圖，手機完全不會抓照片。
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---

{
  photos.length > 0 && (
    <figure
      class="hero-gallery"
      data-carousel
      data-label-pause={t.home.galleryPause}
      data-label-play={t.home.galleryPlay}
      aria-roledescription="carousel"
      aria-label={t.home.galleryLabel}
    >
      <div class="hero-gallery__frame">
        {photos.map((photo, i) => (
          <picture>
            <source media="(max-width: 900px)" srcset={BLANK} />
            <source type="image/avif" srcset={photo.avif} sizes={HERO_PHOTO_SIZES} />
            <source type="image/webp" srcset={photo.webp} sizes={HERO_PHOTO_SIZES} />
            <img
              class={i === 0 ? 'is-active' : undefined}
              src={photo.fallback}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              data-caption={photo.caption}
            />
          </picture>
        ))}
        <figcaption class="hero-gallery__caption" data-caption-target>
          {photos[0].caption}
        </figcaption>
      </div>

      {photos.length > 1 && (
        <div class="hero-gallery__controls">
          <button type="button" class="hero-gallery__toggle" data-toggle aria-label={t.home.galleryPause}>
            <svg class="icon-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <rect x="2" y="1" width="3" height="10" fill="currentColor" />
              <rect x="7" y="1" width="3" height="10" fill="currentColor" />
            </svg>
            <svg class="icon-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M3 1l8 5-8 5z" fill="currentColor" />
            </svg>
          </button>
          <div class="hero-gallery__dots">
            {photos.map((_, i) => (
              <button
                type="button"
                class="hero-gallery__dot"
                data-dot={i}
                aria-label={t.home.gallerySlide.replace('{n}', String(i + 1))}
                aria-current={i === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
        </div>
      )}
    </figure>
  )
}

<script>
  // 每 5.5 秒換一張；滑鼠移入或鍵盤聚焦時暫停，系統開啟「減少動態」時預設不自動播放。
  const INTERVAL = 5500;
  // 與 CSS 的 900px 斷點一致；窄螢幕輪播隱藏，計時器也不跑
  const desktop = window.matchMedia('(min-width: 901px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLImageElement>('img')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const caption = root.querySelector<HTMLElement>('[data-caption-target]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    if (slides.length < 2) return;

    let index = 0;
    let timer: number | undefined;
    let userPaused = reduceMotion;
    let hovering = false;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((img, i) => img.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
      if (caption) caption.textContent = slides[index].dataset.caption ?? '';
    };

    const sync = () => {
      window.clearInterval(timer);
      root.dataset.paused = String(userPaused);
      toggle?.setAttribute(
        'aria-label',
        (userPaused ? root.dataset.labelPlay : root.dataset.labelPause) ?? ''
      );
      if (desktop.matches && !userPaused && !hovering && !document.hidden) {
        timer = window.setInterval(() => show(index + 1), INTERVAL);
      }
    };

    const setHovering = (value: boolean) => {
      hovering = value;
      sync();
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        sync();
      })
    );
    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      sync();
    });
    root.addEventListener('mouseenter', () => setHovering(true));
    root.addEventListener('mouseleave', () => setHovering(false));
    root.addEventListener('focusin', () => setHovering(true));
    root.addEventListener('focusout', () => setHovering(false));
    document.addEventListener('visibilitychange', sync);
    desktop.addEventListener('change', sync);

    sync();
  });
</script>
